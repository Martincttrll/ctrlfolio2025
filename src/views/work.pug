---
    template: work
    pagination: 
        data: prismic.works
        size: 1
        alias: work
---
extends ./_layouts/layout.pug
block content
    .work
        .work__wrapper 
            .liquid__background__wrapper
                .work__img__wrapper
                    img(src=work.data.img.url, alt=work.data.title[0].text).work__img
                .work__content
                    .work__info 
                        .work__tags= work.data.tags.map((t) => '[' + t.tag + ']').join(' ')
                        a(href=work.data.link.url, target="_blank").work__link.external Live website &#8599;
                    h1.work__title= work.data.title[0].text
                    .work__text!= work.data.descriptionHtml
                    .work__carousel
                        each item in work.data.carousel
                            if item.img1
                                .work__carousel__img__wrapper
                                    img(
                                        src=item.img1.url,
                                        alt=work.data.title[0].text
                                    ).work__carousel__img

            include ./_includes/footer.pug